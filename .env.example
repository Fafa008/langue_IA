# ============================================================
# CENTRE DE LANGUES IA — Variables d'environnement
# ============================================================
# Copiez ce fichier en .env et remplissez les valeurs
# NE JAMAIS COMMITER le fichier .env
# ============================================================

# ===== Base de données PostgreSQL =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=centre_langues
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://admin:changeme@localhost:5432/centre_langues

# ===== Backend FastAPI =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=changeme_super_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ===== Frontend Next.js =====
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_IA_URL=http://localhost:8001
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=changeme_nextauth_secret

# ===== IA Service =====
IA_HOST=0.0.0.0
IA_PORT=8001

# ===== OpenAI (Chatbot) =====
OPENAI_API_KEY=changeme
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500

# ===== Modèles IA locaux =====
MODEL_DIAGNOSTIC_PATH=./models/diagnostic.pkl
MODEL_RECO_PATH=./models/recommandation.pkl

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ===== Email (SMTP) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=changeme
SMTP_PASSWORD=changeme
SMTP_FROM=noreply@centre-langues.mg

# ===== Environnement =====
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# ===== Sécurité =====
BCRYPT_ROUNDS=12
RATE_LIMIT_PER_MINUTE=60

# ===== Sauvegarde =====
BACKUP_ENABLED=True
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30