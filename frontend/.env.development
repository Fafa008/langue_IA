# Valeurs par défaut pour `npm run dev` (jamais utilisées en production). Aucun secret ici.
# Pour les changer sur votre poste sans modifier ce fichier : les redéfinir dans frontend/.env.local

# URL du backend FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000

# true  : les services renvoient les données de src/mocks (le backend n'est pas nécessaire)
# false : appels réels vers NEXT_PUBLIC_API_URL
NEXT_PUBLIC_API_MOCK=true
