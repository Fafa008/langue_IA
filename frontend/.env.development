# Valeurs par défaut pour `npm run dev` (jamais utilisées en production). Aucun secret ici.
# Pour les changer sur votre poste sans modifier ce fichier : les redéfinir dans frontend/.env.local

# URL du backend FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000

# Deux presets seulement : "reel" (backend partout) ou "demo" (maquette simulée + IA réelle).
NEXT_PUBLIC_MODE=demo

# Scénario du parcours simulé en mode demo.
NEXT_PUBLIC_PARCOURS_MOCK_SCENARIO=passif
